# === Required ===
SECRET_KEY=change-me-to-a-long-random-string-in-production

# SQLite (default, works on any VPS) OR Postgres (Railway/Render/Supabase)
# DATABASE_URL=sqlite:///./storage/platform.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Public HTTPS URL of this server (required for Telegram webhooks)
BASE_URL=https://your-app.up.railway.app

# CORS — include your frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# === Optional ===
PORT=8000
HOST=0.0.0.0
RELOAD=false
DEFAULT_POINTS=100000
POINTS_PER_COMMAND=1
MAX_EXEC_SECONDS=160
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Email OTP (production) — if unset, OTP is printed to server logs
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com
