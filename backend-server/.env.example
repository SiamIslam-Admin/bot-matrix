# === Required ===
SECRET_KEY=change-me-to-a-long-random-string-in-production

# SQLite (default) OR Postgres
# DATABASE_URL=sqlite:///./storage/platform.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Public HTTPS URL (required for Telegram webhooks)
BASE_URL=https://your-app.up.railway.app

# CORS — include your frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

PORT=8000
HOST=0.0.0.0
RELOAD=false
DEFAULT_POINTS=100000
MAX_EXEC_SECONDS=160
